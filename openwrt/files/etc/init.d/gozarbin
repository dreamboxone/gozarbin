#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: AGPL-3.0-only
# Copyright (C) 2026 dreamboxone

START=95
STOP=10
USE_PROCD=1

. /lib/functions.sh

reason_file=/var/run/gozarbin/transparent-off

service_triggers() {
	procd_add_reload_trigger gozarbin
	procd_add_reload_trigger firewall
}

# Why transparent mode is not running, in one word, for the settings page to
# report. Guessing at it there produced a card that contradicted the one beside
# it, so the answer is written down by the side that actually knows.
stand_down() {
	logger -t gozarbin "$2"
	echo "$1" > "$reason_file"
	transparent=0
}

start_service() {
	local enabled mode transparent force socks_address socks_port http_port mark
	local protocol scan ip_mode noize perf log_level quick config_file singbox
	config_load gozarbin
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get mode main mode tproxy
	config_get_bool transparent main transparent 1
	config_get_bool force main force_with_passwall2 0
	config_get socks_address main socks_address 127.0.0.1
	config_get socks_port main socks_port 1819
	config_get http_port main http_port 0
	config_get mark main mark 0x0aff
	config_get protocol main protocol masque
	config_get scan main scan balanced
	config_get ip_mode main ip_mode v4
	config_get noize main noize firewall
	config_get perf main perf low
	config_get log_level main log_level info
	config_get_bool quick main quick_reconnect 1
	config_get config_file main config_file /etc/gozarbin/gozarbin.toml

	mkdir -p /var/run/gozarbin
	rm -f "$reason_file"

	# Another transparent proxy on this router will swallow Gozarbin's own traffic
	# unless the mark says otherwise, and the symptom is a tunnel that connects
	# and then carries nothing at all.
	case "$mark" in
		*ff|*FF) ;;
		*)
			if /usr/libexec/gozarbin/passwall2-detect.sh --installed >/dev/null 2>&1; then
				logger -t gozarbin "firewall mark $mark does not end in ff; Passwall2 will capture Gozarbin's own traffic and the tunnel will carry nothing"
			fi
			;;
	esac

	# SOCKS5-only is a mode of its own, not a broken transparent setup.
	[ "$mode" = socks ] && transparent=0

	singbox=$(/usr/libexec/gozarbin/singbox.sh --path 2>/dev/null)

	if [ "$transparent" = 1 ]; then
		if /usr/libexec/gozarbin/passwall2-detect.sh --active >/dev/null 2>&1 && [ "$force" != 1 ]; then
			stand_down passwall2 'Passwall2 is active; transparent mode was not started'
		elif ! /usr/libexec/gozarbin/deps.sh --check; then
			stand_down dependencies \
				"missing dependencies for transparent mode:$(/usr/libexec/gozarbin/deps.sh --missing)"
		elif [ -z "$singbox" ]; then
			stand_down singbox 'no sing-box core installed for Gozarbin; transparent mode was not started'
		fi
	fi

	procd_open_instance gozarbin
	procd_set_param command /usr/bin/gozarbin --bind "${socks_address}:${socks_port}" --mark "$mark" --protocol "$protocol" --scan "$scan" --ip "$ip_mode" --noize "$noize" --perf "$perf" --log-level "$log_level" --config "$config_file"
	[ "$quick" = 1 ] && procd_append_param command --quick-reconnect
	[ "$http_port" -gt 0 ] 2>/dev/null && procd_append_param command --http-proxy "${socks_address}:${http_port}"
	procd_set_param env HOME=/etc/gozarbin
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="65535 65535"
	procd_close_instance

	# Accounting and the daily core check belong to the service, not to
	# transparent mode, so they run in every mode.
	procd_open_instance monitor
	procd_set_param command /usr/libexec/gozarbin/monitor.sh
	procd_set_param respawn 3600 30 5
	procd_close_instance

	if [ "$transparent" != 1 ]; then
		# No prerouting rules of ours, so nothing here can disturb another
		# transparent proxy. The byte counters still go in, so the page keeps
		# reporting what left through the SOCKS5 proxy.
		/usr/libexec/gozarbin/firewall.sh accounting || true
		return 0
	fi
	# Both of these before any redirect exists. A router whose LAN is pointed at
	# a port with nothing listening on it has no internet at all, which is a far
	# worse failure than transparent mode not starting.
	if ! /usr/libexec/gozarbin/firewall.sh singbox-config; then
		stand_down singbox 'sing-box config could not be generated; transparent mode was not started'
		/usr/libexec/gozarbin/firewall.sh accounting || true
		return 0
	fi
	/usr/libexec/gozarbin/firewall.sh start || return 1
	procd_open_instance transparent
	procd_set_param command "$singbox" run -c /var/run/gozarbin/sing-box.json
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	/usr/libexec/gozarbin/firewall.sh stop
	rm -f "$reason_file"
}

reload_service() {
	stop
	start
}
