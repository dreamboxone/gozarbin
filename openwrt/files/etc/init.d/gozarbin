#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: AGPL-3.0-only
# Copyright (C) 2026 dreamboxone

START=95
STOP=10
USE_PROCD=1

. /lib/functions.sh

reason_file=/var/run/gozarbin/transparent-off

service_triggers() {
	procd_add_reload_trigger gozarbin
	procd_add_reload_trigger firewall
}

# Why transparent mode is not running, in one word, for the settings page to
# report. Guessing at it there produced a card that contradicted the one beside
# it, so the answer is written down by the side that actually knows.
stand_down() {
	logger -t gozarbin "$2"
	echo "$1" > "$reason_file"
	transparent=0
}

start_service() {
	local enabled mode transparent force socks_address socks_port http_port mark
	local protocol scan ip_mode noize perf log_level quick config_file singbox dns passwall2
	local unblock unblock_port unblock_tor_port
	local tor_reverse tor_scan_fallback tor_scan_env
	config_load gozarbin
	# Before the enabled check, so a disabled service can never leave the
	# network's DNS pointed at it. Nothing happens unless there is a file to
	# remove.
	/usr/libexec/gozarbin/dns.sh off
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get mode main mode tproxy
	# The mode alone decides: transparent unless it is SOCKS5-only, below.
	transparent=1
	config_get_bool force main force_with_passwall2 0
	config_get socks_address main socks_address 127.0.0.1
	config_get socks_port main socks_port 1819
	config_get http_port main http_port 0
	config_get mark main mark 0x0aff
	config_get protocol main protocol masque
	config_get_bool tor_reverse main tor_reverse 0
	config_get_bool tor_scan_fallback main tor_scan_fallback 0
	config_get scan main scan balanced
	config_get ip_mode main ip_mode v4
	config_get noize main noize firewall
	config_get perf main perf low
	config_get log_level main log_level info
	config_get_bool quick main quick_reconnect 1
	config_get_bool dns main dns 1
	config_get_bool unblock main unblock 0
	config_get unblock_port main unblock_port 1823
	config_get unblock_tor_port main unblock_tor_port 1824
	config_get config_file main config_file /etc/gozarbin/gozarbin.toml

	mkdir -p /var/run/gozarbin
	rm -f "$reason_file" /var/run/gozarbin/wanted /var/run/gozarbin/dns-wanted

	# Another transparent proxy on this router will swallow Gozarbin's own traffic
	# unless the mark says otherwise, and the symptom is a tunnel that connects
	# and then carries nothing at all.
	case "$mark" in
		*ff|*FF) ;;
		*)
			if /usr/libexec/gozarbin/passwall2-detect.sh --installed >/dev/null 2>&1; then
				logger -t gozarbin "firewall mark $mark does not end in ff; Passwall2 will capture Gozarbin's own traffic and the tunnel will carry nothing"
			fi
			;;
	esac

	# SOCKS5-only is a mode of its own, not a broken transparent setup.
	[ "$mode" = socks ] && transparent=0

	singbox=$(/usr/libexec/gozarbin/singbox.sh --path 2>/dev/null)

	passwall2=0
	/usr/libexec/gozarbin/passwall2-detect.sh --active >/dev/null 2>&1 && passwall2=1

	if [ "$transparent" = 1 ]; then
		if [ "$passwall2" = 1 ] && [ "$force" != 1 ]; then
			stand_down passwall2 'Passwall2 is active; transparent mode was not started'
		elif ! /usr/libexec/gozarbin/deps.sh --check; then
			stand_down dependencies \
				"missing dependencies for transparent mode:$(/usr/libexec/gozarbin/deps.sh --missing)"
		elif [ -z "$singbox" ]; then
			stand_down singbox 'no sing-box core installed for Gozarbin; transparent mode was not started'
		fi
	fi

	procd_open_instance gozarbin
	procd_set_param command /usr/bin/gozarbin --bind "${socks_address}:${socks_port}" --mark "$mark" --protocol "$protocol" --scan "$scan" --ip "$ip_mode" --noize "$noize" --perf "$perf" --log-level "$log_level" --config "$config_file"
	case "$protocol" in
		masque|mim)
			[ "$tor_reverse" = 1 ] && procd_append_param command --tor-reverse
			[ "$tor_scan_fallback" = 1 ] && tor_scan_env='AETHER_TOR_SCAN_FALLBACK=1'
			;;
	esac
	[ "$quick" = 1 ] && procd_append_param command --quick-reconnect
	[ "$http_port" -gt 0 ] 2>/dev/null && procd_append_param command --http-proxy "${socks_address}:${http_port}"
	procd_set_param env HOME=/etc/gozarbin AETHER_TOR_PT_DIR=/usr/libexec/gozarbin/pt $tor_scan_env
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="65535 65535"
	procd_close_instance

	# Accounting and the daily core check belong to the service, not to
	# transparent mode, so they run in every mode.
	procd_open_instance monitor
	procd_set_param command /usr/libexec/gozarbin/monitor.sh
	procd_set_param respawn 3600 30 5
	procd_close_instance

	if [ "$transparent" != 1 ]; then
		# No prerouting rules of ours, so nothing here can disturb another
		# transparent proxy. The byte counters still go in, so the page keeps
		# reporting what left through the SOCKS5 proxy.
		/usr/libexec/gozarbin/firewall.sh accounting || true
		return 0
	fi
	# Both of these before any redirect exists. A router whose LAN is pointed at
	# a port with nothing listening on it has no internet at all, which is a far
	# worse failure than transparent mode not starting.
	if ! /usr/libexec/gozarbin/firewall.sh singbox-config; then
		stand_down singbox 'sing-box config could not be generated; transparent mode was not started'
		/usr/libexec/gozarbin/firewall.sh accounting || true
		return 0
	fi
	if [ "$mode" = tun ]; then
		# TUN mode has no redirect to hold back: sing-box takes the traffic the
		# moment it starts. What can go in beforehand has to: the escape rule
		# that keeps Gozarbin's own tunnel out of sing-box's routes. Leaving this
		# to monitor.sh, as the TProxy redirect is, meant it never went in at all
		# — the monitor only knows how to wait for a TProxy port.
		/usr/libexec/gozarbin/firewall.sh start || return 1
	else
		# The counters can go in now. The redirect cannot: sing-box dials the
		# core's SOCKS port for every connection it accepts, and that port does
		# not exist until the core has found a gateway — seconds on a good day,
		# minutes when it has to scan for one. A LAN pointed at it before then has
		# every single connection refused, which is a worse failure than not
		# being proxied yet. monitor.sh puts the redirect in once both ends are
		# really listening, and takes it out again if either stops.
		/usr/libexec/gozarbin/firewall.sh accounting || true
		echo transparent > /var/run/gozarbin/wanted
		# Passwall2 points dnsmasq at itself. Two proxies each rewriting where
		# dnsmasq forwards is the same fight as two of them on one prerouting
		# hook, so while it is active — even with transparent mode forced on —
		# DNS stays Passwall2's.
		[ "$dns" = 1 ] && [ "$passwall2" = 0 ] && touch /var/run/gozarbin/dns-wanted
	fi
	procd_open_instance transparent
	procd_set_param command "$singbox" run -c /var/run/gozarbin/sing-box.json
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# The non-Iranian exit, for the services that refuse Iran. Cloudflare places
	# a WARP exit wherever the connection to it starts, so this core dials its
	# WARP connection through Tor and comes out on a Cloudflare address abroad —
	# not a Tor exit, which those same services turn away on sight. Only sing-box
	# routes anything to it, so without transparent mode it would sit idle on
	# 30 MB of memory; it starts here or not at all.
	#
	# Under its own name, so its log lines are its own: tunnel.sh reads the main
	# core's log to report the main tunnel, and two cores scanning under one name
	# would read as one core doing both. Tor's directory cache lives in RAM,
	# because it rewrites megabytes a day and this router's flash has to last.
	if [ "$unblock" = 1 ] && [ -n "$(uci -q get gozarbin.main.unblock_domain)" ]; then
		ln -sf /usr/bin/gozarbin /var/run/gozarbin/gozarbin-unblock
		mkdir -p /var/run/gozarbin/unblock-tor
		procd_open_instance unblock
		procd_set_param command /var/run/gozarbin/gozarbin-unblock --tor-reverse \
			--bind "127.0.0.1:${unblock_port}" --tor-bind "127.0.0.1:${unblock_tor_port}" \
			--tor-dir /var/run/gozarbin/unblock-tor --mark "$mark" --ip v4 --perf low \
			--log-level "$log_level" --config /etc/gozarbin/unblock.toml
		[ "$quick" = 1 ] && procd_append_param command --quick-reconnect
		procd_set_param env HOME=/etc/gozarbin AETHER_TOR_PT_DIR=/usr/libexec/gozarbin/pt
		# Tor can take minutes to find its way out, so it gets more patience
		# than the main core before procd gives up on it.
		procd_set_param respawn 3600 30 10
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param limits nofile="65535 65535"
		procd_close_instance
	fi
}

stop_service() {
	# The markers go before anything else. procd only kills monitor.sh after
	# this function returns, so for the whole of it the monitor is still
	# reconciling — and while the markers said transparent mode was wanted, it
	# saw DNS switched off and switched it straight back on. The service then
	# stopped with dnsmasq forwarding every name on the network to a port nobody
	# was listening on.
	rm -f /var/run/gozarbin/wanted /var/run/gozarbin/dns-wanted
	# DNS next: once sing-box is gone, dnsmasq forwarding to it resolves
	# nothing for anyone on the network.
	/usr/libexec/gozarbin/dns.sh off
	/usr/libexec/gozarbin/firewall.sh stop
	rm -f "$reason_file"
}

reload_service() {
	stop
	start
}
