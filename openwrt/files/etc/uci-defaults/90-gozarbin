# /etc/config/gozarbin is a conffile, so an upgrade keeps the one already on the
# router. Options added by a newer release are filled in here instead.

set_default() {
	[ -n "$(uci -q get "gozarbin.main.$1")" ] && return 0
	uci set "gozarbin.main.$1=$2"
}

if [ -n "$(uci -q get gozarbin.main)" ]; then
	# 0x0a37 shipped before it was known that Passwall2 captures every packet
	# the router sends unless the mark's low byte is 0xff. A tunnel under that
	# old mark connects and then carries nothing, so it is corrected here.
	[ "$(uci -q get gozarbin.main.mark)" = 0x0a37 ] && uci set gozarbin.main.mark=0x0aff
	set_default tproxy_mark 0x0a38
	# 2.1.2 dropped the switch for routing the network through the tunnel; the
	# mode alone decides. Switched off in TProxy or TUN mode it was a SOCKS5-only
	# setup in all but name, so that is what it becomes.
	if [ "$(uci -q get gozarbin.main.transparent)" = 0 ]; then
		uci set gozarbin.main.mode=socks
	fi
	uci -q delete gozarbin.main.transparent
	set_default mode tproxy
	set_default http_port 0
	set_default tun_name gozarbin-tun
	set_default tun_address 172.19.0.1/30
	set_default tun_address6 'fdfe:dcba:9876::1/126'
	set_default tun_mtu 9000
	set_default singbox_log_level warn
	set_default accounting 1
	# 2.1.2 folded the separate Iran IP list into the GeoIP and GeoSite rule sets,
	# under the old list's name. Whoever had either one sending Iranian traffic
	# direct still does; the options that no longer mean anything go.
	if [ -n "$(uci -q get gozarbin.main.iran4_url)$(uci -q get gozarbin.main.geo_action)" ]; then
		direct=0
		[ "$(uci -q get gozarbin.main.iran_bypass)" = 0 ] || direct=1
		[ "$(uci -q get gozarbin.main.geo_enabled)" = 1 ] &&
			[ "$(uci -q get gozarbin.main.geo_action)" = direct ] && direct=1
		uci set gozarbin.main.geo_enabled="$direct"
		uci -q delete gozarbin.main.iran_bypass
		uci -q delete gozarbin.main.iran4_url
		uci -q delete gozarbin.main.iran6_url
		uci -q delete gozarbin.main.geo_action
		rm -f /etc/gozarbin/iran4.txt* /etc/gozarbin/iran6.txt*
	fi
	set_default geo_enabled 1
	set_default dns 1
	set_default dns_port 1822
	set_default dns_server 1.1.1.1
	# The domain list only on the upgrade that introduces the option. After that
	# an empty list is somebody's decision, not a gap to fill.
	if [ -z "$(uci -q get gozarbin.main.unblock)" ]; then
		for domain in anthropic.com claude.ai claude.com claudeusercontent.com openai.com chatgpt.com oaistatic.com oaiusercontent.com spotify.com scdn.co spotifycdn.com gemini.google.com aistudio.google.com generativelanguage.googleapis.com meta.ai; do
			uci add_list gozarbin.main.unblock_domain="$domain"
		done
	fi
	set_default unblock 0
	set_default unblock_port 1823
	set_default unblock_tor_port 1824
	set_default geoip_url 'https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geoip-ir.srs'
	set_default geosite_url 'https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geosite-ir.srs'
	set_default geosite_ads_url 'https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geosite-category-ads-all.srs'
	set_default block_ads 0
	uci commit gozarbin
fi

mkdir -p /etc/gozarbin/geo
/etc/init.d/gozarbin enable
exit 0
