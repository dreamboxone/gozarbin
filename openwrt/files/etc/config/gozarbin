config gozarbin 'main'
	option enabled '0'
	option mode 'tproxy'
	option force_with_passwall2 '0'
	option socks_address '127.0.0.1'
	option socks_port '1819'
	option http_port '0'
	option tproxy_port '1821'
	# Deliberately NOT the same as `mark`. `mark` is what Gozarbin puts on its own
	# sockets so the firewall lets them out; this one is put on intercepted LAN
	# packets to steer them to the local TProxy socket. Give both the same value
	# and the routing rule meant for intercepted traffic also catches Gozarbin's
	# own, sending the tunnel to loopback and every scan comes back empty.
	option tproxy_mark '0x0a38'
	option tun_name 'gozarbin-tun'
	option tun_address '172.19.0.1/30'
	option tun_address6 'fdfe:dcba:9876::1/126'
	option tun_mtu '9000'
	# The low byte must stay 0xff. Passwall2, Passwall and ShadowSocksR all
	# treat `mark & 0xff == 0xff` as "not mine, leave it alone", and their
	# output chains otherwise pull every packet the router sends — including
	# Gozarbin's own tunnel — into their proxy, where it dies silently.
	option mark '0x0aff'
	option route_table '103'
	option protocol 'masque'
	option scan 'balanced'
	option ip_mode 'v4'
	option noize 'firewall'
	option perf 'low'
	option log_level 'info'
	option singbox_log_level 'warn'
	option quick_reconnect '1'
	option accounting '1'
	# Iranian sites and services go direct, recognised by address (GeoIP) and by
	# name (GeoSite). One source for both, and for the kernel's fast path too.
	option geo_enabled '1'
	# The network's DNS, resolved through the tunnel while transparent mode is up.
	# Without it the filter answers names itself and devices connect to the block
	# page's address, which no proxy can fix afterwards.
	option dns '1'
	option dns_port '1822'
	option dns_server '1.1.1.1'
	# Services that refuse Iran — Anthropic, OpenAI, Spotify, Gemini, Meta AI —
	# reached through a second WARP connection dialled over Tor. Cloudflare places
	# a WARP exit wherever the connection to it starts, so starting it from a Tor
	# exit abroad gives a Cloudflare address outside Iran. Slower, and about
	# 30 MB of memory, so off until asked for.
	option unblock '0'
	option unblock_port '1823'
	option unblock_tor_port '1824'
	list unblock_domain 'anthropic.com'
	list unblock_domain 'claude.ai'
	list unblock_domain 'claude.com'
	list unblock_domain 'claudeusercontent.com'
	list unblock_domain 'openai.com'
	list unblock_domain 'chatgpt.com'
	list unblock_domain 'oaistatic.com'
	list unblock_domain 'oaiusercontent.com'
	list unblock_domain 'spotify.com'
	list unblock_domain 'scdn.co'
	list unblock_domain 'spotifycdn.com'
	list unblock_domain 'gemini.google.com'
	list unblock_domain 'aistudio.google.com'
	list unblock_domain 'generativelanguage.googleapis.com'
	list unblock_domain 'meta.ai'
	option geoip_url 'https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geoip-ir.srs'
	option geosite_url 'https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geosite-ir.srs'
	option geosite_ads_url 'https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geosite-category-ads-all.srs'
	option block_ads '0'
	list lan_interface 'br-lan'
