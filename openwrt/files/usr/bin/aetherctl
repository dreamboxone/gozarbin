#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# Copyright (C) 2026 dreamboxone

case "$1" in
	on)
		uci set aether.main.enabled=1
		uci commit aether
		/etc/init.d/aether enable
		/etc/init.d/aether restart
		;;
	off)
		uci set aether.main.enabled=0
		uci commit aether
		/etc/init.d/aether stop
		;;
	restart) /etc/init.d/aether restart ;;
	status)
		/etc/init.d/aether status
		/usr/libexec/aether/passwall2-detect.sh
		/usr/libexec/aether/deps.sh
		/usr/libexec/aether/traffic.sh
		;;
	version)
		[ -r /usr/share/aether/version ] && cat /usr/share/aether/version
		/usr/bin/aether --version 2>/dev/null
		;;
	traffic) exec /usr/libexec/aether/traffic.sh ;;
	deps) exec /usr/libexec/aether/deps.sh "${2:---json}" ;;
	install-deps) exec /usr/libexec/aether/deps.sh --install ;;
	update-iran) exec /usr/libexec/aether/update-iran.sh ;;
	update-geo) exec /usr/libexec/aether/geo-update.sh ;;
	mode)
		[ -n "$2" ] || { uci -q get aether.main.mode; exit 0; }
		case "$2" in
			tproxy|tun|socks) ;;
			*) echo 'mode must be tproxy, tun or socks' >&2; exit 2 ;;
		esac
		uci set aether.main.mode="$2"
		uci commit aether
		[ "$(uci -q get aether.main.enabled)" = 1 ] && /etc/init.d/aether restart
		;;
	*)
		cat >&2 <<'USAGE'
Usage: aetherctl <command>

  on               enable the service and start it
  off              stop the service and keep it disabled
  restart          restart the service
  status           service, Passwall2, dependency and traffic report
  version          package and core versions
  traffic          one JSON line of live counters
  deps [--json]    dependency report
  install-deps     install whatever dependency is missing
  update-iran      refresh the Iran IP ranges
  update-geo       refresh the geoip/geosite rule sets
  mode [name]      show, or set: tproxy | tun | socks
USAGE
		exit 2
		;;
esac
