#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# Copyright (C) 2026 dreamboxone

case "$1" in
	on)
		uci set gozarbin.main.enabled=1
		uci commit gozarbin
		/etc/init.d/gozarbin enable
		/etc/init.d/gozarbin restart
		;;
	off)
		uci set gozarbin.main.enabled=0
		uci commit gozarbin
		/etc/init.d/gozarbin stop
		;;
	restart) /etc/init.d/gozarbin restart ;;
	fix-mark)
		uci set gozarbin.main.mark=0x0aff
		uci commit gozarbin
		/etc/init.d/gozarbin restart
		;;
	rescan)
		# Gozarbin reuses the last gateway that worked and skips scanning, which is
		# what makes startup quick and what makes it look like it never scans.
		# Removing that note is the only way to insist on a fresh sweep.
		rm -f /etc/gozarbin/*lastconn*.toml
		uci set gozarbin.main.enabled=1
		uci commit gozarbin
		/etc/init.d/gozarbin enable
		/etc/init.d/gozarbin restart
		;;
	status)
		/etc/init.d/gozarbin status
		/usr/libexec/gozarbin/passwall2-detect.sh
		/usr/libexec/gozarbin/deps.sh
		/usr/libexec/gozarbin/singbox.sh --state
		/usr/libexec/gozarbin/traffic.sh
		;;
	version)
		[ -r /usr/share/gozarbin/version ] && cat /usr/share/gozarbin/version
		/usr/bin/gozarbin --version 2>/dev/null
		printf 'sing-box core: %s (%s)\n' \
			"$(/usr/libexec/gozarbin/singbox.sh --version 2>/dev/null)" \
			"$(/usr/libexec/gozarbin/singbox.sh --origin 2>/dev/null)"
		;;
	singbox) exec /usr/libexec/gozarbin/singbox.sh "${2:---state}" "$3" ;;
	install-singbox) exec /usr/libexec/gozarbin/singbox.sh --install "$2" ;;
	traffic) exec /usr/libexec/gozarbin/traffic.sh ;;
	deps) exec /usr/libexec/gozarbin/deps.sh "${2:---json}" ;;
	install-deps) exec /usr/libexec/gozarbin/deps.sh --install ;;
	update-iran) exec /usr/libexec/gozarbin/update-iran.sh ;;
	update-geo) exec /usr/libexec/gozarbin/geo-update.sh ;;
	mode)
		[ -n "$2" ] || { uci -q get gozarbin.main.mode; exit 0; }
		case "$2" in
			tproxy|tun|socks) ;;
			*) echo 'mode must be tproxy, tun or socks' >&2; exit 2 ;;
		esac
		uci set gozarbin.main.mode="$2"
		uci commit gozarbin
		[ "$(uci -q get gozarbin.main.enabled)" = 1 ] && /etc/init.d/gozarbin restart
		;;
	*)
		cat >&2 <<'USAGE'
Usage: gozarbinctl <command>

  on               enable the service and start it
  off              stop the service and keep it disabled
  restart          restart the service
  rescan           forget the cached gateway and scan for a new one
  fix-mark         set the firewall mark to one Passwall2 lets through
  status           service, Passwall2, dependency and traffic report
  version          package and core versions
  traffic          one JSON line of live counters
  deps [--json]    dependency report
  install-deps     install whatever dependency is missing
  update-iran      refresh the Iran IP ranges
  update-geo       refresh the geoip/geosite rule sets
  singbox [op]     Gozarbin's sing-box core: --state, --version, --origin, --check
  install-singbox [version]
                   install or update Gozarbin's own sing-box core
  mode [name]      show, or set: tproxy | tun | socks
USAGE
		exit 2
		;;
esac
