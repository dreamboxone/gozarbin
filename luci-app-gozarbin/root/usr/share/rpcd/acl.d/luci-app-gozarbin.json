{
  "luci-app-gozarbin": {
    "description": "Grant access to Gozarbin configuration",
    "read": {
      "cgi-io": [
        "exec"
      ],
      "uci": [
        "gozarbin"
      ],
      "ubus": {
        "service": [
          "list"
        ],
        "file": [
          "exec",
          "read",
          "stat"
        ]
      },
      "file": {
        "/usr/libexec/gozarbin/history.sh report": [
          "exec"
        ],
        "/usr/libexec/gozarbin/passwall2-detect.sh --json": [
          "exec"
        ],
        "/usr/libexec/gozarbin/system-info.sh": [
          "exec"
        ],
        "/usr/libexec/gozarbin/deps.sh --json": [
          "exec"
        ],
        "/usr/libexec/gozarbin/traffic.sh": [
          "exec"
        ],
        "/usr/libexec/gozarbin/singbox.sh --state": [
          "exec"
        ],
        "/usr/libexec/gozarbin/tunnel.sh": [
          "exec"
        ],
        "/usr/libexec/gozarbin/singbox.sh --install-status": [
          "exec"
        ],
        "/usr/bin/gozarbinctl update status": [
          "exec"
        ],
        "/usr/share/gozarbin/core-options.json": [
          "read"
        ],
        "/usr/libexec/gozarbin/aether-core.sh status": [
          "exec"
        ],
        "/usr/libexec/gozarbin/singbox-core.sh status": [
          "exec"
        ],
        "/usr/libexec/gozarbin/geo-core.sh status": [
          "exec"
        ],
        "/usr/libexec/gozarbin/logs.sh runtime": [
          "exec"
        ],
        "/usr/libexec/gozarbin/logs.sh core": [
          "exec"
        ],
        "/usr/libexec/gozarbin/dashboard.sh": [
          "exec"
        ],
        "/usr/libexec/gozarbin/connectivity.sh status": [
          "exec"
        ]
      }
    },
    "write": {
      "cgi-io": [
        "exec"
      ],
      "uci": [
        "gozarbin"
      ],
      "ubus": {
        "service": [
          "set",
          "delete",
          "signal"
        ],
        "file": [
          "exec"
        ]
      },
      "file": {
        "/etc/init.d/gozarbin start": [
          "exec"
        ],
        "/etc/init.d/gozarbin stop": [
          "exec"
        ],
        "/etc/init.d/gozarbin restart": [
          "exec"
        ],
        "/etc/init.d/gozarbin reload": [
          "exec"
        ],
        "/usr/bin/gozarbinctl update-geo": [
          "exec"
        ],
        "/usr/bin/gozarbinctl install-deps": [
          "exec"
        ],
        "/usr/bin/gozarbinctl install-singbox": [
          "exec"
        ],
        "/usr/bin/gozarbinctl rescan": [
          "exec"
        ],
        "/usr/bin/gozarbinctl fix-mark": [
          "exec"
        ],
        "/usr/bin/gozarbinctl install-singbox --background": [
          "exec"
        ],
        "/usr/bin/gozarbinctl update check": [
          "exec"
        ],
        "/usr/bin/gozarbinctl update install": [
          "exec"
        ],
        "/usr/libexec/gozarbin/aether-core.sh check": [
          "exec"
        ],
        "/usr/libexec/gozarbin/aether-core.sh install": [
          "exec"
        ],
        "/usr/libexec/gozarbin/aether-core.sh register": [
          "exec"
        ],
        "/usr/libexec/gozarbin/aether-core.sh clear-psiphon": [
          "exec"
        ],
        "/usr/libexec/gozarbin/singbox-core.sh check": [
          "exec"
        ],
        "/usr/libexec/gozarbin/singbox-core.sh install": [
          "exec"
        ],
        "/usr/libexec/gozarbin/geo-core.sh update": [
          "exec"
        ],
        "/usr/bin/gozarbinctl on": [
          "exec"
        ],
        "/usr/bin/gozarbinctl off": [
          "exec"
        ],
        "/usr/libexec/gozarbin/logs.sh clear-runtime": [
          "exec"
        ],
        "/usr/libexec/gozarbin/logs.sh clear-core": [
          "exec"
        ],
        "/usr/libexec/gozarbin/geo-core.sh update geoip": [
          "exec"
        ],
        "/usr/libexec/gozarbin/geo-core.sh update geosite": [
          "exec"
        ],
        "/usr/libexec/gozarbin/geo-core.sh update ads": [
          "exec"
        ]
      }
    }
  }
}
